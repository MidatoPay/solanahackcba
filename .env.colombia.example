# Copy to .env.colombia. Never reuse a mainnet treasury or a production database.
APP_COUNTRY=CO
APP_ENVIRONMENT=sandbox
PLATFORM_DEPLOYMENT_ID=colombia-sandbox
PLATFORM_ENABLED=false
ONEPAY_ACCOUNT_REF=onepay-sandbox
ONEPAY_API_KEY=
ONEPAY_WEBHOOK_SECRET=
ONEPAY_WEBHOOK_TOKEN=
# Dedicated Colombia sandbox PostgreSQL. Must differ from legacy AIVEN_PG_URL.
PLATFORM_DATABASE_URL=
PLATFORM_DATABASE_CA_CERT=
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_SOLANA_CLUSTER=devnet
SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_WSS=wss://api.devnet.solana.com
TREASURY_SECRET_KEY=
INTERNAL_WORKER_SECRET=
PAYMENTS_BASE_URL=http://localhost:8888
PAYMENTS_ADMIN_USER_IDS=
FX_PROVIDER=criptoya
FX_CACHE_TTL_SECONDS=60
FX_MAX_AGE_SECONDS=300
CONVERSION_FEE_BPS=50
TRANSFER_DAILY_SOL_BUDGET=0.05
TRANSFER_MAX_SOL_COST=0.003
# Optional, server-side voice parser. Digit-based local commands work without it.
ANTHROPIC_API_KEY=
