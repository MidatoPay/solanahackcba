{
  "name": "midato-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node --env-file=.env node_modules/netlify-cli/bin/run.js dev --offline",
    "build": "vite build",
    "build:colombia": "node --env-file=.env.colombia node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "colombia:env": "node scripts/prepare-colombia-env.js",
    "colombia:check": "node --env-file=.env.colombia scripts/check-platform.js",
    "colombia:migrate": "node --env-file=.env.colombia scripts/migrate-platform.js",
    "dev:colombia": "node scripts/dev-colombia.js",
    "dev:check:colombia": "node scripts/check-colombia-dev.js",
    "ngrok:setup": "pwsh -NoProfile -File scripts/ngrok-colombia.ps1 setup",
    "ngrok:check:colombia": "pwsh -NoProfile -File scripts/ngrok-colombia.ps1 check",
    "tunnel:colombia": "pwsh -NoProfile -File scripts/ngrok-colombia.ps1 start",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "functions:check": "node scripts/check-functions.js",
    "deps:check": "npm audit --omit=dev --audit-level=high --fetch-retries=0 --fetch-timeout=15000",
    "payments:env": "node scripts/prepare-payments-env.js",
    "payments:env:production": "node scripts/prepare-payments-env.js .env.production",
    "payments:check": "node --env-file=.env scripts/check-payments-config.js",
    "db:check:payments": "node --env-file=.env scripts/check-payments-database.js",
    "db:migrate:payments": "node --env-file=.env scripts/migrate-payments.js"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.36.1",
    "@privy-io/server-auth": "^1.32.5",
    "@solana-program/memo": "^0.13.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@stripe/stripe-js": "^9.16.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "ethers": "^6.13.4",
    "jsqr": "^1.4.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@vitejs/plugin-react": "^6.0.5",
    "netlify-cli": "^27.1.0",
    "vite": "^8.2.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "proxy-addr": "2.0.8",
    "@fastify/busboy": "3.2.2",
    "image-size": "2.0.3",
    "ws": "8.21.2",
    "uuid": "11.1.1"
  }
}
