# Copy values to Netlify's production context; never commit the completed file.
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
AIVEN_PG_URL=
AIVEN_PG_CA_CERT=

VITE_SOLANA_CLUSTER=mainnet-beta
# SOLANA_RPC is private. Browser HTTP RPC uses the same-origin /rpc proxy.
SOLANA_RPC=
VITE_SOLANA_WSS=
TREASURY_SECRET_KEY=

MP_ENVIRONMENT=production
MP_ACCESS_TOKEN=, vi
MP_USER_ID=
MP_EXTERNAL_POS_ID=
MP_WEBHOOK_SECRET=
CONVERSION_FEE_BPS=50
ETH_RPC_URL=
# Required. Maximum Chainlink USD/ARS quote age in seconds; older quotes reject the charge.
# 90000 = 25 hours (published heartbeat of 86400 s + 1 h margin).
CHAINLINK_MAX_AGE_SECONDS=90000
PAYMENTS_BASE_URL=https://YOUR-SITE.netlify.app
INTERNAL_WORKER_SECRET=
PAYMENTS_ENABLED=false
PAYMENTS_ADMIN_USER_IDS=

# USDC transfers: enable only after migration and wallet/sponsorship validation.
TRANSFERS_ENABLED=false
# Optional production pilot: exact Privy user IDs, comma-separated. Empty denies all while disabled.
TRANSFERS_ALLOWED_USER_IDS=
TRANSFER_DAILY_SOL_BUDGET=0.05
TRANSFER_MAX_SOL_COST=0.003
# Acceso protegido: definir explícitamente el dominio de producción, sin esquema en RP_ID.
# SECURITY_PIN_PEPPER=
# SECURITY_RP_ID=app.example.com
# SECURITY_ORIGINS=https://app.example.com
# SECURITY_ENFORCED=true
# SECURITY_PILOT_USER_IDS= # Solo se usa con SECURITY_ENFORCED=false; DID exactos.
# RESEND_API_KEY=
# SECURITY_RECOVERY_FROM=MidatoPay <seguridad@dominio-verificado.example>
# SECURITY_RECOVERY_PEPPER= # Independiente del PIN y del entorno de staging.
